@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/${PROJECT_NAME}Targets.cmake")

set(${PROJECT_NAME}_DEMOS @BUILD_DEMOS@)
set(${PROJECT_NAME}_BENCHMARKS @BUILD_BENCHMARKS@)

# Set component flags based on how the library was built
set(${PROJECT_NAME}_CUDA_SUPPORT @WITH_CUDA@)
set(${PROJECT_NAME}_OPENCL_SUPPORT @WITH_OPENCL@)
set(${PROJECT_NAME}_OPENCV_SUPPORT @WITH_OPENCV@)
set(${PROJECT_NAME}_GDCM_SUPPORT @WITH_GDCM@)
set(${PROJECT_NAME}_TIFF_SUPPORT @WITH_TIFF@)

# Display information about the installed package
if(NOT ${PROJECT_NAME}_FIND_QUIETLY)
    message(STATUS "Found ${PROJECT_NAME} @PROJECT_VERSION@")
    message(STATUS "  - CUDA support: ${${PROJECT_NAME}_CUDA_SUPPORT}")
    message(STATUS "  - OpenCL support: ${${PROJECT_NAME}_OPENCL_SUPPORT}")
    message(STATUS "  - OpenCV support: ${${PROJECT_NAME}_OPENCV_SUPPORT}")
    message(STATUS "  - GDCM support: ${${PROJECT_NAME}_GDCM_SUPPORT}")
    message(STATUS "  - TIFF support: ${${PROJECT_NAME}_TIFF_SUPPORT}")
    message(STATUS "  - Demos included: ${${PROJECT_NAME}_DEMOS}")
    message(STATUS "  - Benchmarks included: ${${PROJECT_NAME}_BENCHMARKS}")
endif()

check_required_components("${PROJECT_NAME}")
